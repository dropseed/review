#!/bin/bash
set -e
cd "$(dirname "$0")/.."

VERSION="$1"
NOTES_FILE="$2"
TARGET_SHA="$3"

if [ -z "$VERSION" ] || [ -z "$NOTES_FILE" ]; then
    echo "Usage: scripts/gh-release <version> <notes-file> [<target-sha>]"
    echo "Example: scripts/gh-release 0.0.4 /tmp/release-notes.md"
    echo ""
    echo "With <target-sha>, the tag v<version> is created at that commit by"
    echo "the release itself (how the release workflow publishes — no tag"
    echo "exists until the artifacts do). Without it, the tag must already exist."
    exit 1
fi

if [ ! -f "$NOTES_FILE" ]; then
    echo "Error: notes file not found: $NOTES_FILE"
    exit 1
fi

# Artifact source dirs
AARCH64_DIR="target/aarch64-apple-darwin/release/bundle"
X86_64_DIR="target/x86_64-apple-darwin/release/bundle"

# Create temp staging dir
STAGING=$(mktemp -d)
trap 'rm -rf "$STAGING"' EXIT

echo "Staging artifacts in $STAGING..."

# Copy DMGs with arch-specific names (strip version for stable download URLs)
cp "$AARCH64_DIR/dmg/Spur_${VERSION}_aarch64.dmg" "$STAGING/Spur_aarch64.dmg"
cp "$X86_64_DIR/dmg/Spur_${VERSION}_x64.dmg" "$STAGING/Spur_x64.dmg"

# Copy .app.tar.gz and .sig with arch-specific names
cp "$AARCH64_DIR/macos/Spur.app.tar.gz" "$STAGING/Spur_aarch64.app.tar.gz"
cp "$AARCH64_DIR/macos/Spur.app.tar.gz.sig" "$STAGING/Spur_aarch64.app.tar.gz.sig"
cp "$X86_64_DIR/macos/Spur.app.tar.gz" "$STAGING/Spur_x64.app.tar.gz"
cp "$X86_64_DIR/macos/Spur.app.tar.gz.sig" "$STAGING/Spur_x64.app.tar.gz.sig"

# Read signatures
SIG_AARCH64=$(cat "$STAGING/Spur_aarch64.app.tar.gz.sig")
SIG_X86_64=$(cat "$STAGING/Spur_x64.app.tar.gz.sig")

# Generate latest.json (Tauri v1-compatible updater manifest)
PUB_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
BASE_URL="https://github.com/dropseed/spur/releases/latest/download"

cat > "$STAGING/latest.json" <<EOF
{
  "version": "$VERSION",
  "pub_date": "$PUB_DATE",
  "platforms": {
    "darwin-aarch64": {
      "signature": "$SIG_AARCH64",
      "url": "$BASE_URL/Spur_aarch64.app.tar.gz"
    },
    "darwin-x86_64": {
      "signature": "$SIG_X86_64",
      "url": "$BASE_URL/Spur_x64.app.tar.gz"
    }
  }
}
EOF

echo "Generated latest.json"

# Create GitHub release with all staged artifacts
echo ""
echo "Creating GitHub release v$VERSION..."
TARGET_ARGS=()
if [ -n "$TARGET_SHA" ]; then
    TARGET_ARGS=(--target "$TARGET_SHA")
fi
gh release create "v$VERSION" "${TARGET_ARGS[@]}" --title "v$VERSION" --notes-file "$NOTES_FILE" \
    "$STAGING/Spur_aarch64.dmg" \
    "$STAGING/Spur_x64.dmg" \
    "$STAGING/Spur_aarch64.app.tar.gz" \
    "$STAGING/Spur_aarch64.app.tar.gz.sig" \
    "$STAGING/Spur_x64.app.tar.gz" \
    "$STAGING/Spur_x64.app.tar.gz.sig" \
    "$STAGING/latest.json"

echo ""
RELEASE_URL="https://github.com/dropseed/spur/releases/v$VERSION"
echo "Release published: $RELEASE_URL"
