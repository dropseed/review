#!/bin/bash
set -e
cd "$(dirname "$0")/.."

echo "=== TypeScript Type Check ==="
(cd desktop && npx tsc --noEmit)
echo "TypeScript type check passed!"

echo ""
echo "=== TypeScript Tests ==="
(cd desktop && npm test)
echo "TypeScript tests passed!"

echo ""
echo "=== Rust Tests ==="
# `daemon` implies `terminal`, which links the zig-built VT engine.
scripts/check-vt-toolchain
cargo test -p review --features symbols-all,cli,server,daemon,daemon-client
# The desktop crate owns the daemon lifecycle (attach-vs-spawn, version respawn)
# and the terminal event payloads — both worth gating on.
cargo test -p review-desktop
echo "Rust tests passed!"

echo ""
echo "=== All tests passed! ==="
