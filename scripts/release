#!/bin/bash
set -e
cd "$(dirname "$0")/.."

BUMP="$1"
NOTES_FILE="$2"

if { [ "$BUMP" != "patch" ] && [ "$BUMP" != "minor" ]; } || [ -z "$NOTES_FILE" ]; then
    echo "Usage: scripts/release <patch|minor> <notes-file>"
    echo "Example: scripts/release patch /tmp/release-notes.md"
    echo ""
    echo "Bumps versions, commits with the notes as the message body, pushes,"
    echo "and dispatches the Release workflow. The workflow builds, signs, and"
    echo "publishes — the tag is only created there, after the builds succeed."
    exit 1
fi

if [ ! -s "$NOTES_FILE" ]; then
    echo "error: notes file is missing or empty: $NOTES_FILE"
    echo ""
    echo "The notes become the release commit's body, which the workflow"
    echo "publishes verbatim as the GitHub release notes. Write them first."
    exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Releases come off the default branch. Cutting one from a feature branch tags
# a commit that isn't on the line users track, and the updater would ship it —
# a mistake worth catching before anything is pushed.
DEFAULT_BRANCH=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
DEFAULT_BRANCH="${DEFAULT_BRANCH:-master}"
if [ "$BRANCH" != "$DEFAULT_BRANCH" ]; then
    echo "error: on branch '$BRANCH', but releases are cut from '$DEFAULT_BRANCH'."
    echo ""
    echo "Switch to $DEFAULT_BRANCH (merging this branch first if it holds the"
    echo "work you meant to release), then re-run."
    exit 1
fi

echo "Checking the branch can be pushed..."
git fetch origin "$BRANCH"
if [ -n "$(git log --oneline "HEAD..origin/$BRANCH")" ]; then
    echo "error: origin/$BRANCH has commits you don't have locally:"
    git log --oneline "HEAD..origin/$BRANCH" | sed 's/^/  /'
    echo ""
    echo "Integrate them first (git pull), then re-run. Releasing now would"
    echo "leave them out of the release — and out of the notes."
    exit 1
fi

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "error: uncommitted changes to tracked files."
    git status --short --untracked-files=no | sed 's/^/  /'
    echo ""
    echo "The release commit must contain only the version bump. Commit or"
    echo "stash first."
    exit 1
fi

# Read current version from package.json
CURRENT=$(grep '"version"' desktop/package.json | head -1 | sed 's/.*"version": "\([^"]*\)".*/\1/')
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"

case "$BUMP" in
    minor)
        MINOR=$((MINOR + 1))
        PATCH=0
        ;;
    patch)
        PATCH=$((PATCH + 1))
        ;;
esac

VERSION="${MAJOR}.${MINOR}.${PATCH}"

if git ls-remote --exit-code origin "refs/tags/v$VERSION" > /dev/null 2>&1; then
    echo "error: tag v$VERSION already exists on origin."
    exit 1
fi

echo ""
echo "Bumping version: $CURRENT -> $VERSION"

# Update desktop/package.json
sed -i '' 's/"version": "[^"]*"/"version": "'"$VERSION"'"/' desktop/package.json

# Update core/Cargo.toml (only the package version, not dependency versions)
awk -v ver="$VERSION" '!done && /^version = "/ { sub(/^version = "[^"]*"/, "version = \"" ver "\""); done=1 } 1' core/Cargo.toml > core/Cargo.toml.tmp && mv core/Cargo.toml.tmp core/Cargo.toml

# Update desktop/tauri/Cargo.toml (only the package version, not dependency versions)
awk -v ver="$VERSION" '!done && /^version = "/ { sub(/^version = "[^"]*"/, "version = \"" ver "\""); done=1 } 1' desktop/tauri/Cargo.toml > desktop/tauri/Cargo.toml.tmp && mv desktop/tauri/Cargo.toml.tmp desktop/tauri/Cargo.toml

# Update desktop/tauri/tauri.conf.json
sed -i '' 's/"version": "[^"]*"/"version": "'"$VERSION"'"/' desktop/tauri/tauri.conf.json

# Sync Cargo.lock to the bumped manifests. --workspace touches only workspace
# members, and unlike `cargo check` it doesn't compile anything.
cargo update --workspace --quiet

echo ""
echo "Updated versions:"
echo "  desktop/package.json:          $(grep '"version"' desktop/package.json | head -1 | xargs)"
echo "  core/Cargo.toml:               $(grep '^version' core/Cargo.toml | head -1 | xargs)"
echo "  desktop/tauri/Cargo.toml:      $(grep '^version' desktop/tauri/Cargo.toml | head -1 | xargs)"
echo "  desktop/tauri/tauri.conf.json: $(grep '"version"' desktop/tauri/tauri.conf.json | xargs)"

# The release commit carries the notes as its body: the workflow republishes
# that body verbatim as the GitHub release notes, so they live in git history
# and survive re-dispatches.
MSG_FILE=$(mktemp)
trap 'rm -f "$MSG_FILE"' EXIT
{
    echo "Release v$VERSION"
    echo ""
    cat "$NOTES_FILE"
} > "$MSG_FILE"

git commit desktop/package.json core/Cargo.toml desktop/tauri/Cargo.toml desktop/tauri/tauri.conf.json Cargo.lock -F "$MSG_FILE"

echo ""
echo "Created release commit for v$VERSION"

# No tag here — the workflow creates it via `gh release create --target` only
# after both builds are signed and notarized. A failed run leaves just this
# bump commit behind, which the next dispatch reuses.
git push origin "$BRANCH"

echo ""
echo "Dispatching the Release workflow..."
gh workflow run release.yml --ref "$BRANCH" -f tag="v$VERSION"

# The dispatch API is async; give the run a moment to exist before looking it up.
sleep 3
RUN_URL=$(gh run list --workflow=release.yml --branch "$BRANCH" --limit 1 --json url --jq '.[0].url' || true)

echo ""
echo "Release v$VERSION dispatched."
echo "  ${RUN_URL:-https://github.com/dropseed/review/actions/workflows/release.yml}"
echo ""
echo "Watch it with: gh run watch --exit-status"
echo "The tag and GitHub release are created by the workflow on success."
