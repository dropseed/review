#!/bin/bash
set -e
cd "$(dirname "$0")/.."

# Push the release signing secrets to GitHub Actions. One-time setup, re-run
# whenever a credential rotates. The Release workflow (release.yml) consumes
# all of these; nothing signing-related lives on the machine that dispatches
# a release anymore.

REPO="dropseed/review"

# Pin the 1Password account that holds the Dropseed vault. Two accounts share
# the same email, so the account User ID is the only unambiguous identifier.
export OP_ACCOUNT="7ZLPC2L3AJGXDDAMZG5Q44NZGE"
ITEM="op://Dropseed/c6fvj2hcdkxkyzi6mvym5aimge"

echo "Setting secrets on $REPO from 1Password..."
op read "$ITEM/review.key" | gh secret set TAURI_SIGNING_PRIVATE_KEY --repo "$REPO"
op read "$ITEM/password" | gh secret set TAURI_SIGNING_PRIVATE_KEY_PASSWORD --repo "$REPO"
op read "$ITEM/APPLE_SIGNING_IDENTITY" | gh secret set APPLE_SIGNING_IDENTITY --repo "$REPO"
op read "$ITEM/APPLE_ID" | gh secret set APPLE_ID --repo "$REPO"
op read "$ITEM/APPLE_PASSWORD" | gh secret set APPLE_PASSWORD --repo "$REPO"
op read "$ITEM/APPLE_TEAM_ID" | gh secret set APPLE_TEAM_ID --repo "$REPO"

# The Developer ID certificate isn't in 1Password — it lives in the login
# keychain. Export it as a passworded .p12 for Tauri to import on the runner
# (APPLE_CERTIFICATE / APPLE_CERTIFICATE_PASSWORD). `security export` takes
# every codesigning identity, which is fine: APPLE_SIGNING_IDENTITY picks the
# right one at signing time. Expect keychain permission prompts here.
echo ""
echo "Exporting code signing identities from the keychain"
echo "(approve the keychain prompts that appear)..."
P12_DIR=$(mktemp -d)
trap 'rm -rf "$P12_DIR"' EXIT
P12="$P12_DIR/identities.p12"
P12_PASSWORD=$(openssl rand -base64 24)

security export -t identities -f pkcs12 -P "$P12_PASSWORD" -o "$P12"

base64 -i "$P12" | gh secret set APPLE_CERTIFICATE --repo "$REPO"
printf '%s' "$P12_PASSWORD" | gh secret set APPLE_CERTIFICATE_PASSWORD --repo "$REPO"

echo ""
gh secret list --repo "$REPO"
echo ""
echo "Done. The Release workflow has everything it needs."
