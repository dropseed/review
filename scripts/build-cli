#!/bin/bash
set -e
cd "$(dirname "$0")/.."

# Build the Spur CLI binary and place it in desktop/tauri/binaries/ with
# the target-triple suffix required by Tauri's externalBin (sidecar) feature.

TARGET="${TAURI_TARGET_TRIPLE:-$(rustc -vV | sed -n 's/host: //p')}"

echo "Building Spur CLI for $TARGET..."
cargo build --release --target "$TARGET" -p spur --features "cli,push,symbols-all" --bin spur

mkdir -p desktop/tauri/binaries
cp "target/$TARGET/release/spur" "desktop/tauri/binaries/spur-cli-$TARGET"

echo "Sidecar binary ready: desktop/tauri/binaries/spur-cli-$TARGET"
