#!/bin/bash
set -e
cd "$(dirname "$0")/.."

# Check prerequisites
if ! command -v node &> /dev/null; then
    echo "Error: Node.js is not installed"
    exit 1
fi

if ! command -v cargo &> /dev/null; then
    echo "Error: Rust/Cargo is not installed"
    echo "Install from https://rustup.rs"
    exit 1
fi

# vendor/ghostty is the VT engine's source. Fetch it before checking the
# toolchain, so a fresh clone gets one error (a missing zig) rather than two.
git submodule update --init vendor/ghostty

# Zig, and the submodule we just fetched. This is the only script allowed to
# populate vendor/ghostty; the rest only assert it is there.
scripts/check-vt-toolchain

# Set up pre-commit hook
ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

# Install npm dependencies
(cd desktop && npm install)

# Build core Rust crate (desktop crate requires sidecar binary, built separately)
cargo build -p spur
